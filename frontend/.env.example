# Frontend environment.
#
# Copy this file to `.env.local` and fill in the contract/token ids for the
# network you're pointing at. Next.js inlines `NEXT_PUBLIC_*` values at build
# time, so restart `npm run dev` after changing them (and clear `.next` if a
# stale value persists). Hosted builds need the same variables set in the
# host's environment settings, followed by a redeploy.

# Soroban RPC endpoint used to read circles and submit transactions.
# Testnet: https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase transactions are signed for. Must match the network
# behind NEXT_PUBLIC_STELLAR_RPC_URL.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Id of the deployed ajo-circle contract. The contract has no upgrade
# mechanism, so every redeploy produces a new id that must be set here — see
# docs/DEPLOYMENT.md for the deploy steps and env handling.
NEXT_PUBLIC_AJO_CONTRACT_ID=

# Stellar Asset Contract (SAC) address for native XLM on this network.
# Testnet: CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Mainnet uses a different SAC address — see docs/DEPLOYMENT.md.
NEXT_PUBLIC_NATIVE_TOKEN_ID=
